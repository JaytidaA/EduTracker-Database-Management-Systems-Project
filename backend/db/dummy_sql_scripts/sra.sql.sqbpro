select * from student;

/* Group by number of students in a department */
select depName, count(Student.ID) as student_count
from Student, Department
where Student.dep_ID = Department.ID
group by dep_ID;

/* Select the students whose name start with 'S' */
select count(ID) as student_count_start_with_s from Student
where Student.name like 'R%';

/* Group by number of students in a department for departments with at least 5 people */
select depName, count(Student.ID) as student_count
from Student, Department
where Student.dep_ID = Department.ID
group by dep_ID
having student_count &gt;= 5;

/* Use subqueries to find out the students whose name starts with B and have Electrical Department */
select S.ID, S.name 
from Student as S
where S.name like 'B%' and S.ID in (
	select Student.ID
	from Student, Department
	where dep_ID = Department.ID and Department.depName = 'Electrical Engineering'
);

/* Find the departments which have students in it */
select D.ID, D.depName
from Student as S, Department as D
where D.ID = S.dep_ID
group by D.ID;

/* Alternate way to write above query */
select * from Department
where ID in (
	select distinct dep_ID from Student
);

/* Filter out the Departments which do not have an average student phone number (weird concept) greater than another department */
select D.ID, D.depName, avg(S.phone)
from Student as S, Department as D
where D.ID = S.dep_ID
group by D.ID
having avg(S.phone) &gt; some(
	select avg(phone)
	from Student
	group by dep_ID
);</sql><current_tab id="0"/></tab_sql></sqlb_project>
